[Unit]
Description=prosthesis communication bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/prosthesis-communication-bridge
EnvironmentFile=-/etc/prosthesis-communication-bridge.env
ExecStart=/opt/prosthesis-communication-bridge/prosthesis-communication-bridge
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
