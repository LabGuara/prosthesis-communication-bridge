#!/bin/bash

set -e

SERVICE="prosthesis-communication-bridge"

main_pid="$(systemctl show -p MainPID --value "$SERVICE")"

if [ -z "$main_pid" ] || [ "$main_pid" -eq 0 ]; then
    echo "$SERVICE is not running, so there is nothing to signal." >&2
    exit 1
fi

if [ "$(id -u)" -eq 0 ]; then
    kill -USR1 "$main_pid"
else
    sudo kill -USR1 "$main_pid"
fi

echo "Stop signal sent to $SERVICE (pid $main_pid)."
echo "Follow what it did with: watch-prosthesis"
