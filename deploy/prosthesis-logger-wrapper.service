[Unit]
Description=prosthesis logger wrapper
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/prosthesis-logger-wrapper
EnvironmentFile=-/etc/prosthesis-logger-wrapper.env
ExecStart=/opt/prosthesis-logger-wrapper/prosthesis-logger-wrapper
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
