[Unit]
Description=Prothesis logger wrapper
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/prothesis-logger-wrapper/current
EnvironmentFile=-/etc/prothesis-logger-wrapper.env
ExecStart=/usr/bin/sudo /opt/prothesis-logger-wrapper/current/prothesis-logger-wrapper /opt/prothesis-logger-wrapper/current/prothesis-mock.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
