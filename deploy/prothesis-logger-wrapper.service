[Unit]
Description=Prothesis logger wrapper
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/prothesis-logger-wrapper
EnvironmentFile=-/etc/prothesis-logger-wrapper.env
ExecStart=/opt/prothesis-logger-wrapper/prothesis-logger-wrapper
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
