{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug executable 'prothesis-logger-wrapper'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=prothesis-logger-wrapper", "--"]
      },
      "args": [
        "bash",
        "${workspaceFolder}/deploy/prothesis-mock.sh"
      ],
      "windows": {
        "args": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\deploy\\prothesis-mock.ps1"
        ]
      },
      "linux": {
        "args": [
          "bash",
          "${workspaceFolder}/deploy/prothesis-mock.sh"
        ]
      }
    },
    {
      "name": "Debug updater 'update-binary.py'",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/deploy/pi/update-binary.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/deploy/pi/.env"
    },
    {
      "name": "Debug unit tests in executable 'prothesis-logger-wrapper'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--bin=prothesis-logger-wrapper"]
      }
    }
  ]
}
