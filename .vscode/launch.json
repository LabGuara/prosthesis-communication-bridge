{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug executable 'prothesis-logger-wrapper'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=prothesis-logger-wrapper", "--"]
      },
      "args": [
        "powershell.exe",
        "-NoProfile",
        "-Command",
        "while ($true) { Write-Output 'hello'; Start-Sleep -Seconds 5 }"
      ]
    },
    {
      "name": "Debug updater 'update-binary.py'",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/deploy/pi/update-binary.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/deploy/pi/.env"
    },
    {
      "name": "Debug unit tests in executable 'prothesis-logger-wrapper'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--bin=prothesis-logger-wrapper"]
      }
    }
  ]
}
