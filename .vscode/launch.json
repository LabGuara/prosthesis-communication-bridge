{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug executable 'prosthesis-logger-wrapper'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=prosthesis-logger-wrapper"
        ]
      }
    },
    {
      "name": "Debug executable 'prosthesis-logger-wrapper' (mock)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=prosthesis-logger-wrapper"
        ]
      },
      "args": [
        "--mock"
      ]
    },
    {
      "name": "Debug updater 'update-binary.py'",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/deploy/pi/update-binary.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/deploy/pi/.env"
    }
  ]
}